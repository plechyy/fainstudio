---
import { faq } from '../content';
import SectionHead from './SectionHead.astro';
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <SectionHead index="06" name="FAQ" id="faq-title" title="Na co se lidi ptají" />

    <div class="faq reveal">
      {
        faq.map((f) => (
          <details class="faq__item" id={f.q.startsWith('Kolik') ? 'cena' : undefined}>
            <summary>
              <span class="faq__q">{f.q}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <p class="faq__a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    border-top: 1px solid var(--line);
  }
  .faq__item {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq__q {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 560;
    letter-spacing: -0.012em;
    line-height: 1.25;
    transition: transform 140ms var(--ease-out);
  }
  summary:hover .faq__q {
    transform: translateX(4px);
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition: transform 200ms var(--ease-out), background-color 150ms;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 1.5px;
    margin: -0.75px 0 0 -5.5px;
    background: var(--ink);
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  details[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--brand);
    border-color: var(--brand);
  }
  details[open] .faq__icon::before,
  details[open] .faq__icon::after {
    background: var(--on-brand);
  }
  .faq__a {
    padding: 0 48px 26px 0;
    color: var(--ink-2);
    max-width: 62ch;
    text-wrap: pretty;
  }
  @media (prefers-reduced-motion: no-preference) {
    details[open] .faq__a {
      animation: rise 260ms var(--ease-out);
    }
  }
  @media (min-width: 900px) {
    .faq-grid {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 48px;
      align-items: start;
    }
    .faq-grid :global(.shead) {
      grid-template-columns: 1fr;
      position: sticky;
      top: 100px;
    }
  }
</style>

<script>
  // Odkaz „Cena“ v navigaci míří na otázku o ceně — otevřít ji.
  const openFromHash = () => {
    const el = location.hash && document.getElementById(location.hash.slice(1));
    if (el instanceof HTMLDetailsElement) el.open = true;
  };
  addEventListener('hashchange', openFromHash);
  document.querySelectorAll('a[href="#cena"]').forEach((a) => a.addEventListener('click', () => setTimeout(openFromHash)));
  openFromHash();
</script>
