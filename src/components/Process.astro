---
import { process } from '../content';
import SectionHead from './SectionHead.astro';
---

<section class="section" id="postup" aria-labelledby="postup-title">
  <div class="wrap">
    <SectionHead index="03" name="Postup" id="postup-title" title={process.title} lead={process.lead} />

    <ol class="steps">
      {
        process.steps.map((s, i) => (
          <li class="step reveal" style={`--i:${i}`}>
            <div class="step__rule" aria-hidden="true">
              <span class="step__tick" />
            </div>
            <p class="step__num num" aria-hidden="true">
              0{i + 1}
            </p>
            <h3 class="step__name">{s.name}</h3>
            <p class="step__text">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: 0;
    counter-reset: step;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr;
    column-gap: 8px;
    align-content: start;
    padding: 0 0 36px;
  }
  /* svislá kóta na mobilu */
  .step__rule {
    grid-row: 1 / span 3;
    grid-column: 1;
    position: relative;
  }
  .step__rule::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 10px;
    bottom: -10px;
    width: 1px;
    background: var(--line-strong);
  }
  .step:last-child .step__rule::before {
    display: none;
  }
  .step__tick {
    position: absolute;
    left: 0;
    top: 4px;
    width: 13px;
    height: 13px;
    border: 1px solid var(--tick);
    background: var(--bg);
    transform: rotate(45deg);
  }
  .step:first-child .step__tick {
    background: var(--brand);
    border-color: var(--brand);
  }
  .step__num {
    grid-column: 2;
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    color: var(--accent-text);
  }
  .step__name {
    grid-column: 2;
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.08;
  }
  .step__text {
    grid-column: 2;
    margin-top: 10px;
    color: var(--ink-2);
    max-width: 36ch;
    text-wrap: pretty;
  }

  /* vodorovná kóta na desktopu */
  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 28px;
    }
    .step {
      grid-template-columns: 1fr;
      padding: 0;
    }
    .step__rule {
      grid-row: auto;
      grid-column: 1;
      height: 13px;
      margin-bottom: 28px;
    }
    .step__rule::before {
      left: 0;
      right: -28px;
      top: 6px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .step:last-child .step__rule::before {
      display: block;
      right: 0;
      background: linear-gradient(90deg, var(--line-strong), transparent);
    }
    .step__num,
    .step__name,
    .step__text {
      grid-column: 1;
    }
  }
</style>
